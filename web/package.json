{
  "name": "multi-agent-workbench-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build:demo": "vite build --config demo/vite.config.ts",
    "dev:demo": "vite --config demo/vite.config.ts",
    "typecheck:demo": "tsc -p demo/tsconfig.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "mermaid": "^11.12.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "vite": "^7.1.12",
    "vitest": "^4.0.0",
    "typescript": "^6.0.3"
  }
}
