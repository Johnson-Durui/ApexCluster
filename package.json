{
  "name": "multi-agent-workbench",
  "version": "1.0.0",
  "private": true,
  "description": "本机多 Agent 工作台，支持架构、交叉评审、隔离实现和实证验收流水线",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx src/server/main.ts",
    "dev": "tsx watch src/server/main.ts",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "test": "tsx --test --test-concurrency=4 \"tests/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test",
    "probe": "tsx src/cli/probe.ts",
    "models:verify": "tsx scripts/models-verify.ts",
    "pipeline": "tsx scripts/pipeline.ts",
    "demo:offline": "tsx scripts/demo-offline.ts",
    "smoke:live": "tsx scripts/smoke-live.ts",
    "prepublish:scan": "tsx scripts/prepublish-scan.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.9.0",
    "@google/genai": "3.4.0",
    "ajv": "^8.17.1",
    "cross-spawn": "^7.0.6",
    "openai": "7.57.0",
    "tsx": "^4.23.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^6.0.3"
  }
}
